# Copy to .env and fill in. Never commit .env.

# App
CHIRP_ENV=local                 # local | staging | production
OWNER_FIRST_NAME=Shruti
SESSION_SECRET=
DASHBOARD_PASSWORD_HASH=        # generate with: make password
CHIRP_API_TOKEN=

# Database (Supabase Postgres connection string, psycopg format)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/chirp

# Storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=chirp-files

# LLM
LLM_PROVIDER=gemini             # gemini | azure_openai
LLM_MODEL=                      # the current Gemini Flash model id from AI Studio (free tier)
GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
LLM_DAILY_REQUEST_BUDGET=900
LLM_REQUESTS_PER_MINUTE=10

# Manual runs (Find now)
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=

# Applier
APPLY_DRY_RUN=true

# Gmail (P1)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_LABEL=job-alerts
GMAIL_APPLICATIONS_LABEL=applications-sent
